// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum AttendanceStatus {
  PENDING
  ATTENDED
  NO_SHOW
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum CleaningDayStatus {
  OPEN
  CLOSED
  FULL
}

enum TeamType {
  FOOTBALL
  VOLLEYBALL
  NETBALL
  BASKETBALL
  ATHLETICS
}

enum TeamRole {
  PLAYER
  COACH
  KIT_MANAGER
  CHEERLEADER
  TEAM_MANAGER
  MEDICAL
  REFEREE
}

// ============================================
// CORE MODELS
// ============================================

// MAIN USER - Updated for NextAuth
model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName   String
  lastName    String
  email       String   @unique
  password    String?  // Optional for OAuth users
  phoneNumber String?
  
  // OAuth Fields (NextAuth)
  emailVerified DateTime?
  
  // Role & Status - One Role Field
  roleId      String?  @db.ObjectId
  role        Role?    @relation(fields: [roleId], references: [id])
  status      UserStatus @default(ACTIVE)
  isActive    Boolean  @default(true)
  
  // Tech Center Association
  techCenterId String? @db.ObjectId
  techCenter   TechCenter? @relation("UserTechCenter", fields: [techCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  // Location - Not in registration, set by default
  country     String?  @default("Uganda")
  city        String?
  town        String?
  street      String?
  
  // Academic
  generalCourse String?
  tuitionAmount Float?
  takesReligion Boolean @default(false)
  
  // Social
  linkedinUrl String?
  githubUrl   String?
  projectUrls String[]
  profileImageUrl String?
  
  // Team Preferences
  preferredTeamType TeamType?
  preferredTeamRole TeamRole?
  gender String? // "male", "female", "other"
  
  // Password Reset
  resetToken     String?
  resetTokenExpiry DateTime?
  
  // Tracking
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Teacher-Student Assignment
  teacherId    String?  @db.ObjectId
  teacher      User?    @relation("TeacherStudents", fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedStudents User[] @relation("TeacherStudents")
  
  // Courses
  submittedCourses StudentCourse[]
  grades    Grade[] @relation("StudentGrades")
  gradesGiven      Grade[] @relation("GradesGiven")
  
  // Cleaning
  cleaningRegistration CleaningRegistration?
  attendanceRecords    AttendanceRecord[]
  
  // Communication
  authoredAnnouncements Announcement[] @relation("AnnouncementAuthor")
  notifications         Notification[]
  activityLogs          ActivityLog[]
  
  // Simple tracking fields
  createdTechCenterIds String[]
  updatedTechCenterIds String[]
  
  // NextAuth Relations
  accounts Account[]
  sessions Session[]
  
  // Football Team Relations
  footballTeam FootballTeam[]
  
  // General Team Relations
  teamMemberships TeamMembership[]
  
  // AI Assistant Relations
  aiConversations AIConversation[]
  aiLearningProfile AILearningProfile?
  
  @@index([techCenterId])
  @@index([roleId])
  @@index([teacherId])
  @@index([status])
  @@index([country])
  @@map("users")
}

// ROLES
model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique  // "super_admin", "admin", "teacher", "student"
  displayName String
  description String?
  permissions String[]
  
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

// COUNTRIES
model Country {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  code        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  techCenters TechCenter[]

  @@map("countries")
}

// TECH CENTER
model TechCenter {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  code        String   @unique
  description String?
  countryId   String?  @db.ObjectId
  country     Country? @relation(fields: [countryId], references: [id])
  city        String?
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  
  // Simple tracking fields (no relations)
  createdById String?  @db.ObjectId
  updatedById String?  @db.ObjectId
  
  // Relationships - all with NoAction
  users       User[]   @relation("UserTechCenter")
  studentCourses StudentCourse[]
  weeks       Week[]
  cleaningDays CleaningDay[]
  announcements Announcement[]
  activityLogs ActivityLog[]
  footballTeam FootballTeam[]
  teamMemberships TeamMembership[]
  
  @@index([countryId])
  @@index([isActive])
  @@map("tech_centers")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// NEXT-AUTH MODELS
// ============================================

// ACCOUNT - For OAuth providers (GitHub, Google)
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// SESSION - For NextAuth sessions
model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// VERIFICATION TOKEN - For email verification
model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// COURSES (SUBMITTED BY STUDENTS)
// ============================================

// STUDENT COURSE
model StudentCourse {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  code        String
  courseUnit  String
  credits     Int      @default(3)
  takesReligion Boolean @default(false)
  tuition     Float?
  
  // Relationships with NoAction
  studentId   String   @db.ObjectId
  student     User     @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  techCenterId String   @db.ObjectId
  techCenter   TechCenter @relation(fields: [techCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  // Status
  status      EnrollmentStatus @default(ACTIVE)
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dropDate    DateTime?
  
  // Grades - One-to-Many relation
  grades      Grade[]
  
  @@unique([studentId, code])
  @@index([studentId])
  @@index([techCenterId])
  @@index([status])
  @@map("student_courses")
}

// GRADES
model Grade {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // Link to student course
  studentCourseId String @db.ObjectId
  studentCourse   StudentCourse @relation(fields: [studentCourseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  // Student and teacher relations
  studentId   String   @db.ObjectId
  student     User     @relation("StudentGrades", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  assignedBy  String   @db.ObjectId
  teacher     User     @relation("GradesGiven", fields: [assignedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  // Grade details
  gradeLetter String
  gradePoints Float
  score       Float?
  assignedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       String?
  
  @@index([studentCourseId])
  @@index([studentId])
  @@index([assignedBy])
  @@index([gradeLetter])
  @@map("grades")
}

// GRADE SCALE
model GradeScale {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  gradeLetter String   @unique
  minScore    Float
  maxScore    Float
  gradePoints Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("grade_scales")
}

// ============================================
// CLEANING MANAGEMENT
// ============================================

// WEEKS
model Week {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  weekLabel             String
  startDate             DateTime
  endDate               DateTime
  isActive              Boolean  @default(true)
  registrationDeadline  DateTime
  
  techCenterId String   @db.ObjectId
  techCenter   TechCenter @relation(fields: [techCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  createdById String?   @db.ObjectId
  updatedById String?   @db.ObjectId
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  days        CleaningDay[]
  
  @@index([isActive])
  @@index([techCenterId])
  @@index([registrationDeadline])
  @@map("weeks")
}

// CLEANING DAYS
model CleaningDay {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  weekId              String   @db.ObjectId
  week                Week     @relation(fields: [weekId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dayOfWeek           String
  cleaningDate        DateTime
  capacityLimit       Int      @default(0)
  currentRegistrations Int     @default(0)
  status              CleaningDayStatus @default(OPEN)
  
  techCenterId String   @db.ObjectId
  techCenter   TechCenter @relation(fields: [techCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  registrations       CleaningRegistration[]
  attendanceRecords   AttendanceRecord[]
  
  @@index([cleaningDate])
  @@index([techCenterId])
  @@index([status])
  @@map("cleaning_days")
}

// CLEANING REGISTRATION
model CleaningRegistration {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cleaningDayId String   @db.ObjectId
  cleaningDay   CleaningDay @relation(fields: [cleaningDayId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  registeredAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([cleaningDayId])
  @@map("cleaning_registrations")
}

// ATTENDANCE RECORD
model AttendanceRecord {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cleaningDayId String   @db.ObjectId
  cleaningDay   CleaningDay @relation(fields: [cleaningDayId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  status        AttendanceStatus @default(PENDING)
  markedBy      String?  @db.ObjectId
  markedAt      DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([userId, cleaningDayId])
  @@index([cleaningDayId])
  @@index([status])
  @@map("attendance_records")
}

// ============================================
// COMMUNICATION
// ============================================

// ANNOUNCEMENTS
model Announcement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String
  deadline    DateTime?
  
  authorId    String   @db.ObjectId
  author      User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  isGlobal    Boolean  @default(false)
  techCenterId String? @db.ObjectId
  techCenter   TechCenter? @relation(fields: [techCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  scheduledPublishDate DateTime?
  publishedAt  DateTime @default(now())
  expiryDate   DateTime?
  isActive     Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([authorId])
  @@index([techCenterId])
  @@index([isGlobal])
  @@index([publishedAt])
  @@index([deadline])
  @@map("announcements")
}

// NOTIFICATIONS
model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  title       String
  message     String
  type        String
  isRead      Boolean  @default(false)
  link        String?
  readAt      DateTime?
  
  generatedBy String?
  entityType  String?
  entityId    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// ACTIVITY LOG
// ============================================

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  action      String
  entityType  String
  entityId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  location    String?
  
  techCenterId String? @db.ObjectId
  techCenter   TechCenter? @relation(fields: [techCenterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([techCenterId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// ============================================
// FOOTBALL TEAM
// ============================================

model FootballTeam {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // User and Tech Center relations
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  techCenterId String  @db.ObjectId
  techCenter   TechCenter @relation(fields: [techCenterId], references: [id], onDelete: Cascade)
  
  // Player details
  jerseyNumber Int?
  position     String?  // e.g., "Goalkeeper", "Forward", "Midfielder", "Defender"
  
  // Status
  isActive     Boolean  @default(true)
  joinedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@unique([userId, techCenterId])
  @@index([techCenterId])
  @@map("football_teams")
}

// ============================================
// GENERAL TEAM MEMBERSHIPS
// ============================================

model TeamMembership {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // User and Tech Center relations
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  techCenterId String  @db.ObjectId
  techCenter   TechCenter @relation(fields: [techCenterId], references: [id], onDelete: Cascade)
  
  // Team type and role
  teamType    TeamType
  teamRole    TeamRole
  
  // Additional details
  jerseyNumber Int?
  position     String?  // specific position for players
  experience   String?  // experience level
  notes        String?
  
  // Status
  isActive     Boolean  @default(true)
  joinedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([techCenterId])
  @@index([teamType])
  @@index([teamRole])
  @@index([userId])
  @@map("team_memberships")
}

// ============================================
// AI ASSISTANT MODELS
// ============================================

// AI CONVERSATION - Stores chat history
model AIConversation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Conversation metadata
  title       String?  // Auto-generated from first message
  context     String?  // Current page/context when conversation started
  
  // Messages stored as JSON array
  messages    Json     // Array of {role, content, timestamp}
  
  // Learning insights
  topics      String[] // Topics discussed
  difficulty  String?  // easy, medium, hard
  
  // Status
  isActive    Boolean  @default(true)
  archivedAt  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([isActive])
  @@map("ai_conversations")
}

// AI LEARNING PROFILE - Tracks user's learning patterns
model AILearningProfile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  userId      String   @unique @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Learning preferences
  learningStyle String[] // visual, auditory, reading, kinesthetic
  preferredTopics String[]
  difficultyLevel String @default("medium") // beginner, intermediate, advanced
  
  // Academic context
  currentGPA Float?
  strongSubjects String[]
  weakSubjects String[]
  coursesEnrolled String[] // Course codes
  
  // Interaction patterns
  totalQuestionsAsked Int @default(0)
  averageSessionLength Float? // in minutes
  mostActiveHours Int[] // Hours of day when user is most active
  
  // Progress tracking
  conceptsMastered String[]
  conceptsInProgress String[]
  conceptsStruggling String[]
  
  // AI adaptation
  responseStyle String @default("balanced") // concise, detailed, balanced
  languagePreference String @default("english")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("ai_learning_profiles")
}

// AI KNOWLEDGE BASE - Custom data to feed the AI
model AIKnowledgeBase {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // Categorization
  category    String   // e.g., "courses", "policies", "assignments", "resources"
  subcategory String?  // e.g., "BYU-Idaho courses", "grading policies"
  
  // Content
  title       String
  content     String   // Main knowledge content
  summary     String?  // Brief summary for quick reference
  
  // Metadata
  tags        String[] // Searchable tags
  difficulty  String?  // beginner, intermediate, advanced
  priority    Int      @default(0) // Higher priority shown first
  
  // Relationships
  relatedIds  String[] // IDs of related knowledge entries
  
  // Usage tracking
  accessCount Int      @default(0)
  helpfulRating Float? // Average user rating
  
  // Status
  isActive    Boolean  @default(true)
  lastUpdated DateTime @updatedAt
  createdAt   DateTime @default(now())
  
  @@index([category])
  @@index([subcategory])
  @@index([isActive])
  @@index([priority])
  @@map("ai_knowledge_base")
}