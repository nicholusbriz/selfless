{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "selfless-online-status",
  "main": "partyserver/server.ts",
  "compatibility_date": "2026-09-10",
  "durable_objects": {
    "bindings": [
      {
        "name": "Main",
        "class_name": "MainServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MainServer"]
    }
  ]
}
