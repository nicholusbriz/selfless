    "@tanstack/react-query": "^5.0.0",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.0.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.17.0",
    "next": "^16.0.7",
    "next-auth": "^4.24.11",
    "partykit": "^0.0.115",
    "partysocket": "^1.3.0",
    "prisma": "^5.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
