    "concurrently": "^9.2.1",
    "autoprefixer": "^10.5.4",
    "critters": "^0.0.23",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.4"
