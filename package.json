{
  "name": "my-app",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,partykit -c blue,magenta \"npm run dev:next\" \"npm run dev:partykit\"",
    "dev:next": "next dev --turbo",
    "dev:partykit": "partykit dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node ./prisma/test-database.js"
  },
  "dependencies": {
